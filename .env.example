# Langford — LangChain/LangGraph dogfood agent for langchain-colony.
# Copy this file to .env and fill in the values. .env is gitignored.

# --- Colony credentials ---
# Get this from registration: see /home/user/claude-projects/ColonistOne/.langford/config.json
COLONY_API_KEY=col_...

# --- Local LLM (Ollama) ---
# Ollama base URL and model. Default Ollama listens on localhost:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:27b
# Max output tokens per generation. Ollama defaults to 128 which is too
# low for substantive replies — early Langford DMs read like one-liners
# because of this. 1024 gives room for ~3-paragraph DMs and full
# multi-step react traces. Per-tick latency scales roughly linearly
# with this knob; bump to 2048 if you want longer essays at the cost
# of slower swaps.
LANGFORD_MAX_OUTPUT_TOKENS=1024
# Sampling temperature. 0.7 = default. Higher = more variety, lower =
# more deterministic. Tool-calling reliability suffers above ~0.9.
LANGFORD_TEMPERATURE=0.7

# --- Loop enables ---
# v0.1: only the interact loop is enabled. Engage and post are coded but
# gated off — they will be enabled in later versions after we observe
# Langford's reactive behaviour for ~48h.
LANGFORD_INTERACT_ENABLED=true
LANGFORD_ENGAGE_ENABLED=false
LANGFORD_POST_ENABLED=false

# --- Interact loop ---
# How often to poll for new notifications + DMs (seconds).
LANGFORD_POLL_INTERVAL_SEC=120
# Skip notifications older than this on cold-start (seconds).
LANGFORD_COLD_START_WINDOW_SEC=86400

# --- Engagement loop (v0.2+, currently inert) ---
# Comma-separated colony slugs to round-robin engagement on.
LANGFORD_ENGAGE_COLONIES=general,findings,meta
LANGFORD_ENGAGE_INTERVAL_MIN_SEC=900
LANGFORD_ENGAGE_INTERVAL_MAX_SEC=2700

# --- Post loop (v0.3+, currently inert) ---
LANGFORD_POST_COLONY=general
LANGFORD_POST_INTERVAL_MIN_SEC=21600
LANGFORD_POST_INTERVAL_MAX_SEC=43200
LANGFORD_POST_DAILY_LIMIT=3

# --- Safety knobs (v0.2) ---
# Pause the interact loop if Langford's own karma drops below this.
# Reactive replies stay paused until karma recovers (e.g. operator
# upvotes the agent or moderates the offending content). Set to a
# very negative number (e.g. -1000000) to disable the gate.
LANGFORD_MIN_KARMA=-5
# Pre-tick Ollama reachability probe. When true, GET <OLLAMA_BASE_URL>/api/tags
# is checked before each poll; failure pauses the tick (notifications
# stay unread for the next cycle).
LANGFORD_OLLAMA_HEALTH_CHECK=true
# Don't reply via DM if SENDER has karma below this floor (not yet enforced;
# placeholder for a v0.3 gate).
LANGFORD_DM_MIN_KARMA=5
