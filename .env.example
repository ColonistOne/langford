# Langford — LangChain/LangGraph dogfood agent for langchain-colony.
# Copy this file to .env and fill in the values. .env is gitignored.

# --- Colony credentials ---
# Get this from registration: see /home/user/claude-projects/ColonistOne/.langford/config.json
COLONY_API_KEY=col_...

# --- Local LLM (Ollama) ---
# Ollama base URL and model. Default Ollama listens on localhost:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:27b
# Max output tokens per generation. Ollama defaults to 128 which is too
# low for substantive replies — early Langford DMs read like one-liners
# because of this. 1024 gives room for ~3-paragraph DMs and full
# multi-step react traces. Per-tick latency scales roughly linearly
# with this knob; bump to 2048 if you want longer essays at the cost
# of slower swaps.
LANGFORD_MAX_OUTPUT_TOKENS=4096
# Sampling temperature. 0.7 = default. Higher = more variety, lower =
# more deterministic. Tool-calling reliability suffers above ~0.9.
LANGFORD_TEMPERATURE=0.7

# --- Loop enables ---
# v0.1: only the interact loop is enabled. Engage and post are coded but
# gated off — they will be enabled in later versions after we observe
# Langford's reactive behaviour for ~48h.
LANGFORD_INTERACT_ENABLED=true
LANGFORD_ENGAGE_ENABLED=false
LANGFORD_ORIGINATE_ENABLED=false

# --- Interact loop ---
# How often to poll for new notifications + DMs (seconds).
LANGFORD_POLL_INTERVAL_SEC=120
# Skip notifications older than this on cold-start (seconds).
LANGFORD_COLD_START_WINDOW_SEC=86400

# --- Engagement loop (v0.3) ---
# When LANGFORD_ENGAGE_ENABLED=true, this loop wakes on a uniform-random
# interval in [INTERVAL_MIN_SEC, INTERVAL_MAX_SEC], round-robins through
# LANGFORD_ENGAGE_COLONIES, picks the first unseen non-self post, and
# asks the agent to comment / react / skip.
# Conservative defaults during the soak — 15-45 min per tick.
# Order matters: the colony at the head of the list is checked first,
# so put substantive forums (findings, meta, builds) ahead of saturated
# ones (general) — comment-worthy candidates surface earlier and the
# tick is more likely to produce a real comment vs. a low-effort react.
LANGFORD_ENGAGE_COLONIES=findings,meta,builds,general
LANGFORD_ENGAGE_INTERVAL_MIN_SEC=900
LANGFORD_ENGAGE_INTERVAL_MAX_SEC=2700
# How many recent posts to examine per colony when looking for a
# candidate. Higher = less likely to hit "no candidates" but more
# read traffic per tick.
LANGFORD_ENGAGE_CANDIDATE_LIMIT=10
# File where engaged-with post ids are persisted (one per line). The
# loop loads this on boot so a restart doesn't re-pick the same post,
# which it would otherwise do every time under the supervisor pattern.
# Append-only; safe to edit / truncate manually.
LANGFORD_SEEN_POSTS_FILE=.engaged-posts.txt

# --- Welcome loop (v0.6) ---
# Walks recent c/introductions posts and welcomes new agents (recently
# joined, low karma) with a brief, specific comment. Independent
# cadence from the engage loop. The agent decides per-candidate whether
# to welcome or skip — a generic 'welcome to The Colony!' is treated
# as a hallucinated extra action. Disabled by default.
LANGFORD_WELCOME_ENABLED=false
# Cadence (jittered uniform-random per tick).
LANGFORD_WELCOME_INTERVAL_MIN_SEC=900
LANGFORD_WELCOME_INTERVAL_MAX_SEC=2700
# How many recent intros to scan per tick when looking for a candidate.
LANGFORD_WELCOME_CANDIDATE_LIMIT=15
# 'New agent' filter — author must have user_type=agent, joined within
# the last N days, and have karma at most M. Bumping max_days picks up
# slower agents who introduce themselves a week or two after registering;
# bumping max_karma is rarely useful since karma > 50 strongly implies
# they're already established.
LANGFORD_WELCOME_NEW_AGENT_MAX_DAYS=14
LANGFORD_WELCOME_NEW_AGENT_MAX_KARMA=50
# Persisted set of post ids Langford has already evaluated (welcomed or
# skipped). Without this every tick would re-evaluate the same intros.
LANGFORD_WELCOMED_POSTS_FILE=.welcomed-posts.txt

# --- Originate loop (v0.8) ---
# Long-cadence original-post driver. Pulls a recent feed snapshot
# from LANGFORD_ORIGINATE_FEED_COLONIES, frames a one-shot
# "default skip" prompt with the agent's framework lens, and posts
# only when the LLM identifies a fresh observation / technical
# extension / focused question that isn't already saturated.
# Rate-limited via .originated.txt — never two `posted` entries
# within MIN_DAYS_BETWEEN.
LANGFORD_ORIGINATE_INTERVAL_MIN_SEC=129600    # 36h
LANGFORD_ORIGINATE_INTERVAL_MAX_SEC=345600    # 96h
LANGFORD_ORIGINATE_MIN_DAYS_BETWEEN=4
LANGFORD_ORIGINATE_INITIAL_DELAY_SEC=300      # 5 min after boot — supervisor windows are ~21min, longer delays never elapse
LANGFORD_ORIGINATE_FEED_PER_COLONY=8
LANGFORD_ORIGINATE_FEED_COLONIES=findings,meta,general
LANGFORD_ORIGINATE_POST_COLONIES=findings,meta
LANGFORD_ORIGINATE_LEDGER_FILE=.originated.txt

# --- Safety knobs (v0.2) ---
# Pause the interact loop if Langford's own karma drops below this.
# Reactive replies stay paused until karma recovers (e.g. operator
# upvotes the agent or moderates the offending content). Set to a
# very negative number (e.g. -1000000) to disable the gate.
LANGFORD_MIN_KARMA=-5
# Pre-tick Ollama reachability probe. When true, GET <OLLAMA_BASE_URL>/api/tags
# is checked before each poll; failure pauses the tick (notifications
# stay unread for the next cycle).
LANGFORD_OLLAMA_HEALTH_CHECK=true
# Don't reply via DM if SENDER has karma below this floor (not yet enforced;
# placeholder for a v0.3 gate).
LANGFORD_DM_MIN_KARMA=5

# --- v0.11 (2026-05-05): DM-origin prompt framing ---
# Plugin-layer lever on compliance bias for DM dispatches. Three modes:
#   none        — no preamble (pre-v0.11 behaviour, default).
#   peer        — frames the sender as a peer agent on Colony.
#   adversarial — frames the sender as untrusted; instructs refuse of
#                 embedded instructions.
# Applied only to direct_message notifications.
COLONY_DM_PROMPT_MODE=none

# --- v0.13 (2026-05-19): sibling pile-on throttle ---
# Comma-separated user_ids of peer dogfood agents (eliza-gemma, dantic,
# smolag, etc). When set, the engage loop skips a candidate authored by
# one of these IDs if THRESHOLD or more sibling-authored comments are
# already on it. First sibling can engage; later ones bow out, breaking
# the cross-dogfood pile-on dynamic that produced 77%-sibling threads.
#
# Empty (default) = no throttle. THRESHOLD=0 = hard-exclude any
# sibling-authored post regardless of comment count.
#
# Mentions and reply notifications go through the interact loop, not
# the engage loop, so siblings can still reply when explicitly mentioned.
LANGFORD_ENGAGE_SIBLING_IDS=
LANGFORD_ENGAGE_SIBLING_THRESHOLD=1
